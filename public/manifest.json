{
  "manifest_version": 3,
  "name": "GD Helper",
  "version": "2.1.0",
  "description": "Многофункциональное расширение для платформы GreenData: упаковка обновлений, генератор ID алгоритмов, инструмент реализации и задачи YouTrack",
  "permissions": [
    "sidePanel",
    "storage",
    "downloads",
    "tabs",
    "scripting",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Открыть GD Helper",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
