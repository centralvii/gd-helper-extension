{
  "manifest_version": 3,
  "name": "GDHelper - GUF Packer",
  "version": "1.0.0",
  "description": "Инструмент подготовки, переименования по шаблонам и упаковки .guf файлов обновлений GreenData",
  "permissions": [
    "sidePanel",
    "storage",
    "downloads",
    "tabs"
  ],
  "action": {
    "default_title": "Открыть GDHelper",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
